@page "/"
@using Microsoft.EntityFrameworkCore
@inject LibrarySystem.Data.Context.LibraryContext Context

<h1>Översikt</h1>
<p>Snabbstatus för biblioteket.</p>

@if (!loaded)
{
    <p>Laddar statistik...</p>
}
else
{

    <div class="dash-grid">
        <div class="dash-card">
            <div class="dash-title">Böcker</div>
            <div class="dash-value">@bookCount</div>
        </div>

        <div class="dash-card">
            <div class="dash-title">Medlemmar</div>
            <div class="dash-value">@memberCount</div>
        </div>

        <div class="dash-card">
            <div class="dash-title">Aktiva lån</div>
            <div class="dash-value">@activeLoanCount</div>
        </div>

        <div class="dash-card">
            <div class="dash-title">Försenade</div>
            <div class="dash-value">@overdueLoanCount</div>
        </div>
    </div>

  
}

@code {
    private bool loaded;
    private int bookCount;
    private int memberCount;
    private int activeLoanCount;
    private int overdueLoanCount;

    protected override async Task OnInitializedAsync()
    {
        bookCount = await Context.Books.CountAsync();
        memberCount = await Context.Members.CountAsync();

        activeLoanCount = await Context.Loans.CountAsync(l => l.ReturnDate == null);
        overdueLoanCount = await Context.Loans.CountAsync(l => l.ReturnDate == null && l.DueDate < DateTime.Now);

        loaded = true;
    }
}