@page "/loans"
@using LibrarySystem.Core.Models
@using LibrarySystem.Core.Interfaces
@using System.ComponentModel.DataAnnotations
@inject IBookRepository BookRepo
@inject IMemberRepository MemberRepo
@inject ILoanRepository LoanRepo
@rendermode InteractiveServer

<h1>Utlåning</h1>

@if (!loaded)
{
    <p>Laddar...</p>
}
else
{
    <h5>Nytt lån</h5>

    <EditForm Model="@loanModel" OnValidSubmit="CreateLoan" FormName="CreateLoanForm">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="row g-2 align-items-end mb-4">

            <div class="col-md-5">
                <label class="form-label">Bok</label>
                <InputSelect class="form-select" @bind-Value="loanModel.BookId">
                    <option value="0">Välj bok...</option>
                    @foreach (var b in availableBooks)
                    {
                        <option value="@b.Id">@b.Title (@b.ISBN)</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => loanModel.BookId)" />
            </div>

            <div class="col-md-5">
                <label class="form-label">Medlem</label>
                <InputSelect class="form-select" @bind-Value="loanModel.MemberId">
                    <option value="">Välj medlem...</option>
                    @foreach (var m in members)
                    {
                        <option value="@m.MemberId">@m.Name (@m.MemberId)</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => loanModel.MemberId)" />
            </div>

            <div class="col-md-2">
                <button class="btn btn-primary w-100" type="submit">
                    Låna
                </button>
            </div>

        </div>
    </EditForm>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert alert-info">@message</div>
    }

    <h5>Aktiva lån</h5>

    @if (activeLoans.Count == 0)
    {
        <p>Inga aktiva lån.</p>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Bok</th>
                    <th>Medlem</th>
                    <th>Lånedatum</th>
                    <th>Förfallodatum</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var l in activeLoans)
                {
                    var overdue = l.ReturnDate == null && l.DueDate < DateTime.Now;
                    <tr class="@(overdue ? "table-danger" : "")">
                        <td>@(l.Book?.Title ?? "(okänd bok)")</td>
                        <td>@(l.Member?.Name ?? "(okänd medlem)")</td>
                        <td>@l.LoanDate.ToShortDateString()</td>
                        <td>@l.DueDate.ToShortDateString()</td>
                        <td>
                            @if (overdue)
                            {
                                <span class="badge bg-danger">Försenad</span>
                            }
                            else
                            {
                                <span class="badge bg-success">OK</span>
                            }
                        </td>
                        <td>
                            <button class="btn btn-sm btn-outline-secondary"
                                    @onclick="() => ReturnLoan(l.Id)">
                                Returnera
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private bool loaded;

    private List<Book> availableBooks = new();
    private List<Member> members = new();
    private List<Loan> activeLoans = new();

    private string? message;
    private LoanForm loanModel = new();

    private class LoanForm
    {
        [Required(ErrorMessage = "Välj bok")]
        [Range(1, int.MaxValue, ErrorMessage = "Välj bok")]
        public int BookId { get; set; }

        [Required(ErrorMessage = "Välj medlem")]
        public string? MemberId { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await ReloadData();
        loaded = true;
    }

    private async Task ReloadData()
    {
        // Repository calls (ingen EF i UI)
        availableBooks = (await BookRepo.GetAvailableAsync()).ToList();
        members = (await MemberRepo.GetAllAsync()).ToList();
        activeLoans = (await LoanRepo.GetActiveLoansAsync()).ToList();
    }

    private async Task CreateLoan()
    {
        message = null;

        try
        {
            var book = await BookRepo.GetByIdAsync(loanModel.BookId);
            if (book is null)
            {
                message = "Boken hittades inte.";
                return;
            }

            var member = await MemberRepo.GetByMemberIdAsync(loanModel.MemberId ?? "");
            if (member is null)
            {
                message = "Medlemmen hittades inte.";
                return;
            }

            if (!book.IsAvailable)
            {
                message = "Boken är inte tillgänglig.";
                return;
            }

            var loanDate = DateTime.Now;
            var dueDate = loanDate.AddDays(14);

            var loan = new Loan
            {
                BookId = book.Id,
                MemberId = member.MemberId,
                LoanDate = loanDate,
                DueDate = dueDate,
                ReturnDate = null
            };

            // Uppdatera bokstatus
            book.MarkAsLoaned();

            await LoanRepo.AddAsync(loan);
            await LoanRepo.SaveAsync();

            message = "Lån skapat.";
            loanModel.BookId = 0;
            loanModel.MemberId = "";

            await ReloadData();
        }
        catch
        {
            message = "Kunde inte skapa lån. Försök igen.";
        }
    }

    private async Task ReturnLoan(int loanId)
    {
        try
        {
            var loan = await LoanRepo.GetByIdWithDetailsAsync(loanId);
            if (loan is null)
                return;

            loan.ReturnDate = DateTime.Now;

            if (loan.Book != null)
                loan.Book.MarkAsReturned();

            await LoanRepo.SaveAsync();
            await ReloadData();
        }
        catch
        {
            message = "Kunde inte returnera lånet. Försök igen.";
        }
    }
}      