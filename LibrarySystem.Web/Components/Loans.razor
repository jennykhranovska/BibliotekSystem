@page "/loans"
@using LibrarySystem.Core.Models
@using Microsoft.EntityFrameworkCore
@inject LibrarySystem.Data.Context.LibraryContext Context

<h3>Utlåning</h3>

@if (!loaded)
{
    <p>Laddar...</p>
}
else
{
    <h5>Nytt lån</h5>

    <EditForm Model="@loanModel" OnValidSubmit="CreateLoan">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="row g-2 align-items-end mb-4">

            <div class="col-md-5">
                <label class="form-label">Bok</label>
                <InputSelect class="form-select" @bind-Value="loanModel.BookId">
                    <option value="0">Välj bok...</option>
                    @foreach (var b in availableBooks)
                    {
                        <option value="@b.Id">@b.Title (@b.ISBN)</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => loanModel.BookId)" />
            </div>

            <div class="col-md-5">
                <label class="form-label">Medlem</label>
                <InputSelect class="form-select" @bind-Value="loanModel.MemberId">
                    <option value="">Välj medlem...</option>
                    @foreach (var m in members)
                    {
                        <option value="@m.MemberId">@m.Name (@m.MemberId)</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => loanModel.MemberId)" />
            </div>

            <div class="col-md-2">
                <button class="btn btn-primary w-100" type="submit">
                    Låna
                </button>
            </div>

        </div>
    </EditForm>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert alert-info">@message</div>
    }

    <h5>Aktiva lån</h5>

    @if (activeLoans.Count == 0)
    {
        <p>Inga aktiva lån.</p>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Bok</th>
                    <th>Medlem</th>
                    <th>Lånedatum</th>
                    <th>Förfallodatum</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var l in activeLoans)
                {
                    var overdue = l.ReturnDate == null && l.DueDate < DateTime.Now;
                    <tr class="@(overdue ? "table-danger" : "")">
                        <td>@(l.Book?.Title ?? "(okänd bok)")</td>
                        <td>@(l.Member?.Name ?? "(okänd medlem)")</td>
                        <td>@l.LoanDate.ToShortDateString()</td>
                        <td>@l.DueDate.ToShortDateString()</td>
                        <td>
                            @if (overdue)
                            {
                                <span class="badge bg-danger">Försenad</span>
                            }
                            else
                            {
                                <span class="badge bg-success">OK</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private bool loaded;

    private List<Book> availableBooks = new();
    private List<Member> members = new();
    private List<Loan> activeLoans = new();

    private string? message;
    private LoanForm loanModel = new();

    private class LoanForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Välj bok")]
        [System.ComponentModel.DataAnnotations.Range(1, int.MaxValue, ErrorMessage = "Välj bok")]
        public int BookId { get; set; }

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Välj medlem")]
        public string? MemberId { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await ReloadData();
        loaded = true;
    }

    private async Task ReloadData()
    {
        availableBooks = await Context.Books.AsNoTracking()
            .Where(b => b.IsAvailable)
            .OrderBy(b => b.Title)
            .ToListAsync();

        members = await Context.Members.AsNoTracking()
            .OrderBy(m => m.Name)
            .ToListAsync();

        activeLoans = await Context.Loans
            .AsNoTracking()
            .Include(l => l.Book)
            .Include(l => l.Member)
            .Where(l => l.ReturnDate == null)
            .OrderByDescending(l => l.LoanDate)
            .ToListAsync();
    }

    private async Task CreateLoan()
    {
        message = null;

        var book = await Context.Books.FirstOrDefaultAsync(b => b.Id == loanModel.BookId);
        if (book == null)
        {
            message = "Boken hittades inte.";
            return;
        }

        // OBS: MemberId är string Member-modell.
        var member = await Context.Members.FirstOrDefaultAsync(m => m.MemberId == loanModel.MemberId);
        if (member == null)
        {
            message = "Medlemmen hittades inte.";
            return;
        }

        if (!book.IsAvailable)
        {
            message = "Boken är inte tillgänglig.";
            return;
        }

        var loanDate = DateTime.Now;
        var dueDate = loanDate.AddDays(14);

        // Skapa lån och uppdatera bokstatus
        var loan = new Loan
        {
            BookId = book.Id,
            Book = book,
            Member = member,
            MemberId = member.MemberId, 
            LoanDate = loanDate,
            DueDate = dueDate,
            ReturnDate = null
        };

        book.MarkAsLoaned();

        Context.Loans.Add(loan);
        await Context.SaveChangesAsync();

        message = "Lån skapat.";
        loanModel.BookId = 0;
        loanModel.MemberId = "";

        await ReloadData();

    }

    private async Task ReturnLoan(int loanId)
    {
        var loan = await Context.Loans
            .Include(l => l.Book)
            .FirstOrDefaultAsync(l => l.Id == loanId);

        if (loan == null)
            return;

        loan.ReturnDate = DateTime.Now;

        if (loan.Book != null)
            loan.Book.MarkAsReturned();

        await Context.SaveChangesAsync();
        await ReloadData();
    }
}